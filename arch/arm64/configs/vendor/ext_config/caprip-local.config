#
# Local project customizations applied on top of the LineageOS SM6225/caprip
# fragment chain (bengal-perf_defconfig + moto-bengal.config +
# caprip-default.config).
#
# Keep this file minimal: it must only contain options that are not
# expressible through the upstream base/device fragments. Everything else is
# expected to come from upstream and be resolved by olddefconfig.
#
# Release string (no auto localversion suffix).
CONFIG_LOCALVERSION="—WearyStars⭐"
# CONFIG_LOCALVERSION_AUTO is not set

# ReSukiSU + SUSFS root solution.
CONFIG_KSU=y
CONFIG_KSU_FULL_NAME_FORMAT="%TAG_NAME%-%COMMIT_SHA%@%REPO_NAME%"
CONFIG_KSU_MANUAL_HOOK=y
CONFIG_KSU_MANUAL_HOOK_AUTO_SETUID_HOOK=y
CONFIG_KSU_MANUAL_HOOK_AUTO_INITRC_HOOK=y
CONFIG_KSU_MANUAL_HOOK_AUTO_INPUT_HOOK=y
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_TRY_UMOUNT=y

# Validated container prerequisites.
CONFIG_DEVTMPFS=y
CONFIG_PID_NS=y

# Keep the unvalidated IPC/namespace features disabled (SYSVIPC/POSIX_MQUEUE
# bootloop investigations). IPC_NS stays absent because both are disabled.
# CONFIG_SYSVIPC is not set
# CONFIG_POSIX_MQUEUE is not set
# CONFIG_USER_NS is not set
# CONFIG_CGROUP_DEVICE is not set
